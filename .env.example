# Скопируй этот файл в .env и заполни своими данными

# true  = auth и чаты работают через localStorage (без бэкенда)
# false = нужен реальный бэкенд на VITE_API_BASE_URL
VITE_USE_MOCK=true

# Claude API ключ — НЕ попадает в браузер, только в прокси
# Получить: console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-api03-ВАШ_КЛЮЧ_ЗДЕСЬ

# Провайдер AI
VITE_AI_PROVIDER=anthropic

# Модель:
#   claude-haiku-4-5-20251001  — быстрый и дешёвый (рекомендуется)
#   claude-sonnet-4-6          — умнее, дороже
#   claude-opus-4-8            — самый мощный
VITE_AI_MODEL=claude-haiku-4-5-20251001

# URL бэкенда (нужен только если VITE_USE_MOCK=false)
VITE_API_BASE_URL=http://localhost:8000/api
