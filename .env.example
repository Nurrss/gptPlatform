# ─────────────────────────────────────────────────────────────
#  Скопируй этот файл в .env и заполни своими данными
# ─────────────────────────────────────────────────────────────

# Демо-режим (true = без AI, всё в localStorage)
# Поставь false чтобы использовать настоящий AI
VITE_USE_MOCK=false

# ─── Claude (Anthropic) ───────────────────────────────────────
# Ключ БЕЗОПАСЕН — не попадает в браузер, используется только в прокси
ANTHROPIC_API_KEY=

# Модель Claude:
#   claude-sonnet-4-6         — быстрый, хороший баланс (рекомендуется)
#   claude-opus-4-8           — самый умный, дороже
#   claude-haiku-4-5-20251001 — самый быстрый и дешёвый
VITE_AI_PROVIDER=anthropic
VITE_AI_MODEL=claude-haiku-4-5-20251001

# ─── OpenAI (альтернатива) ────────────────────────────────────
# Если хочешь использовать OpenAI вместо Claude:
# VITE_AI_PROVIDER=openai
# VITE_AI_API_KEY=sk-ВАШ_КЛЮЧ_OPENAI    ← этот ключ виден в браузере!
# VITE_AI_MODEL=gpt-4o

# ─── Кастомный URL (необязательно) ───────────────────────────
# Для production — укажи URL своего backend-прокси
# VITE_AI_API_URL=https://your-server.com/claude

# ─── Backend (необязательно) ─────────────────────────────────
# Нужен только если VITE_USE_MOCK=false
VITE_API_BASE_URL=http://localhost:8000/api
